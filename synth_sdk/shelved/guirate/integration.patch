+/* Screen::frame: the raster-clear CALL at 0x01A3BBE0 -> gui_frame_stub: gui_frame(table = P4, dt = R7) does the
+ * clear + screen update loop or skips it (screens/guirate.c), then back to the PlayerManager call (0x01A3BC02).
+ * R7 / P3 / P4 are callee-saved in the C ABI and stay valid for the stock code after it. */
+	.section .hook_guiframe,"ax"
+	jump.l _gui_frame_stub;
+	.section .hook_guisubmit,"ax"
+	call _gui_submit;
+	.text
+	.align 2
+_gui_frame_stub:
+	R0 = P4;
+	R1 = R7;
+	call _gui_frame;
+	jump.l _gui_frame_ret;
+
 /* CALL at 0x01A01844 (patch::sample_path "sampler" check) -> sample_type_eq */
 	.section .hook_samplecheck,"ax"
 	.global __hook_samplecheck
